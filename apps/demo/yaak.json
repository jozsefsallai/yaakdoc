        "name": "Acme Store API",
        "description": "The **Acme Store API** lets you manage products, orders and customers of an Acme storefront.\n\nAll requests are made over HTTPS and return JSON. Authenticate by sending a bearer token in the\n`Authorization` header \u2014 see [Authentication](#authentication).\n\n| Status | Meaning |\n| --- | --- |\n| `2xx` | Success |\n| `4xx` | Client error, check the `error` field |\n| `5xx` | Server error, please retry |\n",
        "headers": [
          {
            "enabled": true,
            "name": "Accept",
            "value": "application/json"
          },
          {
            "enabled": true,
            "name": "User-Agent",
            "value": "acme-docs/1.0"
          },
          {
            "enabled": false,
            "name": "X-Debug",
            "value": "1"
          }
        ],
        "authenticationType": "bearer",
        "authentication": {
          "token": "${[ api_token ]}"
        }
      }
    ],
