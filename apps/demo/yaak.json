    "httpRequests": [
      {
        "model": "http_request",
        "id": "rq_login",
        "createdAt": "2025-06-01T10:00:00",
        "updatedAt": "2025-06-01T10:00:00",
        "workspaceId": "wk_acme",
        "folderId": "fl_auth",
        "name": "Log in",
        "method": "POST",
        "url": "${[ base_url ]}/auth/login",
        "sortPriority": 0,
        "description": "Exchange user credentials for an access token.\n\nThe token expires after **1 hour**; use [Refresh token](#authentication-refresh-token) to get a new one.\n\n```response:200\n{\n  \"accessToken\": \"eyJhbGciOi...\",\n  \"refreshToken\": \"rt_8f2k...\",\n  \"expiresIn\": 3600\n}\n```\n\n```response:401\n{\n  \"error\": \"invalid_credentials\",\n  \"message\": \"Email or password is incorrect.\"\n}\n```",
        "headers": [
          {
            "enabled": true,
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "urlParameters": [],
        "bodyType": "application/json",
        "body": {
          "text": "{\n  \"email\": \"jane@acme.dev\",\n  \"password\": \"${[ password ]}\",\n  \"remember\": true\n}"
        },
        "authenticationType": null,
        "authentication": {}
      },
      {
        "model": "http_request",
        "id": "rq_refresh",
        "createdAt": "2025-06-01T10:00:00",
        "updatedAt": "2025-06-01T10:00:00",
        "workspaceId": "wk_acme",
        "folderId": "fl_auth",
        "name": "Refresh token",
        "method": "POST",
        "url": "${[ base_url ]}/auth/token",
        "sortPriority": 1,
        "description": "Get a new access token using a refresh token (OAuth 2 style form body).",
        "headers": [],
        "urlParameters": [],
        "bodyType": "application/x-www-form-urlencoded",
        "body": {
          "form": [
            {
              "enabled": true,
              "name": "grant_type",
              "value": "refresh_token"
            },
            {
              "enabled": true,
              "name": "refresh_token",
              "value": "${[ refresh_token ]}"
            },
            {
              "enabled": false,
              "name": "scope",
              "value": "products orders"
            }
          ]
        },
        "authenticationType": null,
        "authentication": {}
      },
      {
        "model": "http_request",
        "id": "rq_list_products",
        "createdAt": "2025-06-01T10:00:00",
        "updatedAt": "2025-06-01T10:00:00",
        "workspaceId": "wk_acme",
        "folderId": "fl_products",
        "name": "List products",
        "method": "GET",
        "url": "${[ base_url ]}/stores/${[ store_id ]}/products",
        "sortPriority": 0,
        "description": "Returns a paginated list of products, newest first.\n\n```response\n{\n  \"data\": [\n    {\n      \"id\": \"prod_123\",\n      \"name\": \"Running shoes\",\n      \"price\": 8999,\n      \"currency\": \"USD\"\n    },\n    {\n      \"id\": \"prod_124\",\n      \"name\": \"Trail socks\",\n      \"price\": 1299,\n      \"currency\": \"USD\"\n    }\n  ],\n  \"page\": 1,\n  \"hasMore\": true\n}\n```",
        "headers": [],
        "urlParameters": [
          {
            "enabled": true,
            "name": "page",
            "value": "1"
          },
          {
            "enabled": true,
            "name": "limit",
            "value": "20"
          },
          {
            "enabled": false,
            "name": "search",
            "value": "shoes"
          },
          {
            "enabled": true,
            "name": "sort",
            "value": "-created_at"
          }
        ],
        "bodyType": null,
        "body": {},
        "authenticationType": null,
        "authentication": {}
      },
      {
        "model": "http_request",
        "id": "rq_get_product",
        "createdAt": "2025-06-01T10:00:00",
        "updatedAt": "2025-06-01T10:00:00",
        "workspaceId": "wk_acme",
        "folderId": "fl_products",
        "name": "Get a product",
        "method": "GET",
        "url": "${[ base_url ]}/products/:id",
        "sortPriority": 1,
        "description": "Retrieve a single product by its id.\n\n```response:200\n{\n  \"id\": \"prod_123\",\n  \"name\": \"Running shoes\",\n  \"price\": 8999,\n  \"currency\": \"USD\",\n  \"inStock\": true\n}\n```\n\n```response:404\n{\n  \"error\": \"not_found\",\n  \"message\": \"No product with id prod_999.\"\n}\n```",
        "headers": [],
        "urlParameters": [
          {
            "enabled": true,
            "name": ":id",
            "value": "prod_123"
          }
        ],
        "bodyType": null,
        "body": {},
        "authenticationType": null,
        "authentication": {}
      },
      {
        "model": "http_request",
        "id": "rq_create_product",
        "createdAt": "2025-06-01T10:00:00",
        "updatedAt": "2025-06-01T10:00:00",
        "workspaceId": "wk_acme",
        "folderId": "fl_products",
        "name": "Create a product",
        "method": "POST",
        "url": "${[ base_url ]}/products",
        "sortPriority": 2,
        "description": "Create a new product.\n\n```json\n{ \"id\": \"prod_124\", \"status\": \"draft\" }\n```\n\nThe response contains the created product.\n\nThe API validates the payload and returns `422` when a field is invalid.\n\n```response:201\n{\n  \"id\": \"prod_125\",\n  \"name\": \"Running shoes\",\n  \"status\": \"draft\"\n}\n```\n\n```response:422\n{\n  \"error\": \"validation_failed\",\n  \"fields\": {\n    \"price\": \"must be a positive integer\"\n  }\n}\n```",
        "headers": [
          {
            "enabled": true,
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "enabled": true,
            "name": "Idempotency-Key",
            "value": "${[ uuid.v4() ]}"
          }
        ],
        "urlParameters": [],
        "bodyType": "application/json",
        "body": {
          "text": "{\n  \"name\": \"Running shoes\",\n  \"price\": 8999,\n  \"currency\": \"USD\",\n  \"tags\": [\n    \"sport\",\n    \"shoes\"\n  ],\n  \"inStock\": true,\n  \"dimensions\": {\n    \"weight\": 0.8,\n    \"unit\": \"kg\"\n  }\n}"
        },
        "authenticationType": null,
        "authentication": {}
      },
