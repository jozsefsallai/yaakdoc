{
  "name": "yaakdoc",
  "version": "0.1.0",
  "description": "Static, themable, and LLM-friendly API documentation generated from Yaak exports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yaakdoc": "./bin/yaakdoc.js"
  },
  "exports": {
    ".": {
      "@yaakdoc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./static": {
      "@yaakdoc/source": "./src/static.ts",
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./package.json": "./package.json"
  },
  "keywords": [
    "yaak",
    "api",
    "documentation",
    "docs",
    "static-site-generator",
    "llms.txt",
    "cli"
  ],
  "author": "József Sallai @jozsefsallai",
  "license": "MIT",
  "files": [
    "/bin",
    "/dist",
    "/config.schema.json",
    "/README.md",
    "/LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/generate-schema.js",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "check-types": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozsefsallai/yaakdoc.git",
    "directory": "packages/yaakdoc"
  },
  "bugs": {
    "url": "https://github.com/jozsefsallai/yaakdoc/issues"
  },
  "homepage": "https://github.com/jozsefsallai/yaakdoc#readme",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@shikijs/rehype": "^4.5.0",
    "@yaakdoc/config": "workspace:^",
    "@yaakdoc/core": "workspace:^",
    "@yaakdoc/markdown": "workspace:^",
    "@yaakdoc/react": "workspace:^",
    "@yaakdoc/snippets": "workspace:^",
    "@yaakdoc/theme-kiseki": "workspace:^",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "sirv": "^3.0.2",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "vite": "^8.3.4"
  }
}
