{
  "name": "@yaakdoc/theme-blueprint",
  "version": "0.1.0",
  "description": "Blueprint - a technical-drawing yaakdoc theme with a title block, a sheet index and requests drawn as schematics.",
  "type": "module",
  "exports": {
    ".": "./theme.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "yaak",
    "yaakdoc",
    "yaakdoc-theme",
    "theme",
    "blueprint",
    "technical-drawing",
    "tailwindcss"
  ],
  "yaakdoc": {
    "displayName": "Blueprint",
    "description": "API docs as technical drawings: a title block, a sheet index, numbered parts lists and requests drawn as schematics on a grid.",
    "preview": "https://raw.githubusercontent.com/jozsefsallai/yaakdoc/master/apps/website/public/screenshots/blueprint-dark.webp",
    "demo": "https://demo.yaakdoc.dev/blueprint/"
  },
  "author": "József Sallai @jozsefsallai",
  "license": "MIT",
  "files": [
    "/theme.ts",
    "/src",
    "/components.json",
    "/tsconfig.json",
    "/README.md",
    "/LICENSE"
  ],
  "scripts": {
    "check-types": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozsefsallai/yaakdoc.git",
    "directory": "packages/theme-blueprint"
  },
  "bugs": {
    "url": "https://github.com/jozsefsallai/yaakdoc/issues"
  },
  "homepage": "https://yaakdoc.dev/docs/theming/blueprint",
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yaakdoc/core": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@yaakdoc/react": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  }
}
